{
  "info": {
    "_postman_id": "e4f51523-9e5d-480a-ae74-79f47c812040",
    "name": "ms-account - Part II",
    "description": "Part II verification: profiles, opening amount, zero-fee PYME, transfers and excess movements. Requires customers/cards created by the prerequisite collections.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Reject opening amount below minimum",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Negative opening amount rejected', () => pm.expect(pm.response.code).to.be.oneOf([400,422]));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/accounts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "accounts"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"accountType\": \"SAVINGS\",\n  \"holders\": [\n    \"{{standardCustomerId}}\"\n  ],\n  \"currency\": \"PEN\",\n  \"maxMonthlyMovements\": 20,\n  \"openingAmount\": -1\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
    {
      "name": "02 - Open VIP savings with opening amount and daily average",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('VIP savings opened', () => pm.response.to.have.status(201));",
              "const b=pm.response.json(); pm.test('Opening balance applied', () => pm.expect(b.balance).to.equal(100));",
              "pm.environment.set('vipSavingsId', b.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/accounts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "accounts"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"accountType\": \"SAVINGS\",\n  \"holders\": [\n    \"{{vipCustomerId}}\"\n  ],\n  \"currency\": \"PEN\",\n  \"maxMonthlyMovements\": 2,\n  \"openingAmount\": 100,\n  \"minimumDailyAverage\": 50\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
