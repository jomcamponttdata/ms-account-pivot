        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('PYME checking opened', () => pm.response.to.have.status(201));",
              "const b=pm.response.json(); pm.test('Maintenance fee forced to zero', () => pm.expect(b.maintenanceFee).to.equal(0));",
              "pm.environment.set('pymeCheckingId', b.id);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
