    {
      "name": "05 - Transfer between same customer accounts",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Same-customer transfer succeeds', () => pm.response.to.have.status(201));",
              "const b=pm.response.json(); pm.test('Both movements share correlation', () => pm.expect(b.withdrawal.movementType).to.equal('WITHDRAWAL')); pm.expect(b.deposit.movementType).to.equal('DEPOSIT'); pm.expect(b.correlationId).to.be.a('string');",
              "pm.environment.set('transferCorrelationId', b.correlationId);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/accounts/transfers",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "accounts",
            "transfers"
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\n  \"sourceAccountId\": \"{{vipSavingsId}}\",\n  \"destinationAccountId\": \"{{standardCheckingId}}\",\n  \"amount\": 40,\n  \"description\": \"Part II same-customer transfer\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": []
    },
