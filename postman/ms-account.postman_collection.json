{
  "info": {
    "_postman_id": "a8f0f7bd-36a1-4a5a-8e06-dc1c37ea3ef2",
    "name": "ms-account - Part I",
    "description": "Executable CRUD, balance, operation and error tests for ms-account. Set customerId to an ACTIVE PERSONAL customer that exists in ms-customer before running. Run requests in order with ms-customer, ms-transaction, PostgreSQL and MongoDB available.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "packages": {},
        "exec": [
          "pm.collectionVariables.set('correlationId', pm.variables.replaceIn('{{$guid}}'));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 - Create personal savings account",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "packages": {},
            "exec": [
              "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
              "pm.test('Account opens with zero balance', () => {",
              "    const body = pm.response.json();",
              "    pm.expect(body.id).to.be.a('string').and.not.empty;",
              "    pm.expect(body.accountType).to.equal('SAVINGS');",
              "    pm.expect(body.balance).to.equal(0);",
              "    pm.expect(body.currency).to.equal('PEN');",
              "    pm.expect(body.holders).to.include(pm.variables.get('customerId'));",
              "    pm.expect(pm.response.headers.get('Location')).to.equal('/api/v1/accounts/' + body.id);",
              "    pm.collectionVariables.set('accountId', body.id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Correlation-ID",
            "value": "{{correlationId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"accountType\": \"SAVINGS\",\n  \"holders\": [\"{{customerId}}\"],\n  \"currency\": \"PEN\",\n  \"maxMonthlyMovements\": 5\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/accounts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "accounts"
          ]
        }
      },
      "response": []
    },
    {
      "name": "02 - Find account by ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "packages": {},
            "exec": [
              "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Account is returned by ID', () => {",
              "    const body = pm.response.json();",
              "    pm.expect(body.id).to.equal(pm.collectionVariables.get('accountId'));",
              "    pm.expect(body.accountType).to.equal('SAVINGS');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Correlation-ID",
            "value": "{{correlationId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/accounts/{{accountId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "accounts",
            "{{accountId}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "03 - List accounts by customer and type",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "packages": {},
            "exec": [
              "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Created account appears in the filtered list', () => {",
              "    const body = pm.response.json();",
              "    const ids = body.map(account => account.id);",
              "    pm.expect(ids).to.include(pm.collectionVariables.get('accountId'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Correlation-ID",
            "value": "{{correlationId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/accounts?customerId={{customerId}}&accountType=SAVINGS&page=0&size=20",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "accounts"
          ],
          "query": [
            {
              "key": "customerId",
              "value": "{{customerId}}"
            },
            {
              "key": "accountType",
              "value": "SAVINGS"
            },
            {
              "key": "page",
              "value": "0"
            },
            {
              "key": "size",
              "value": "20"
            }
          ]
        }
      },
      "response": []
    },
    {
      "name": "04 - Get initial balance",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "packages": {},
            "exec": [
              "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Initial balance is zero', () => {",
              "    const body = pm.response.json();",
              "    pm.expect(body.productId).to.equal(pm.collectionVariables.get('accountId'));",
              "    pm.expect(body.productType).to.equal('BANK_ACCOUNT');",
              "    pm.expect(body.balance).to.equal(0);",
              "    pm.expect(body.currency).to.equal('PEN');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Correlation-ID",
            "value": "{{correlationId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/accounts/{{accountId}}/balance",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "accounts",
            "{{accountId}}",
            "balance"
          ]
        }
      },
      "response": []
    },
    {
      "name": "05 - Deposit money",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "packages": {},
            "exec": [
              "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
              "pm.test('Movement receipt matches the deposit', () => {",
              "    const body = pm.response.json();",
              "    pm.expect(body.movementId).to.be.a('string').and.not.empty;",
              "    pm.expect(body.movementType).to.equal('DEPOSIT');",
              "    pm.expect(body.amount).to.equal(25.5);",
              "    pm.expect(body.currency).to.equal('PEN');",
              "    pm.collectionVariables.set('depositMovementId', body.movementId);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Correlation-ID",
            "value": "{{correlationId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 25.50,\n  \"currency\": \"PEN\",\n  \"description\": \"Cash deposit\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/accounts/{{accountId}}/deposits",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "accounts",
            "{{accountId}}",
            "deposits"
          ]
        }
      },
      "response": []
    },
    {
      "name": "06 - Verify balance after deposit",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "packages": {},
            "exec": [
              "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Balance reflects the deposit', () => {",
              "    pm.expect(pm.response.json().balance).to.equal(25.5);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-Correlation-ID",
            "value": "{{correlationId}}"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/v1/accounts/{{accountId}}/balance",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "accounts",
            "{{accountId}}",
            "balance"
          ]
        }
      },
      "response": []
    },
    {
      "name": "07 - Withdraw money",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "packages": {},
            "exec": [
              "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
              "pm.test('Movement receipt matches the withdrawal', () => {",
              "    const body = pm.response.json();",
              "    pm.expect(body.movementType).to.equal('WITHDRAWAL');",
              "    pm.expect(body.amount).to.equal(5.25);",
              "    pm.collectionVariables.set('withdrawalMovementId', body.movementId);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
