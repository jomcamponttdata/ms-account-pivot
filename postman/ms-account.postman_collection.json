{
  "info": {
    "_postman_id": "a8f0f7bd-36a1-4a5a-8e06-dc1c37ea3ef2",
    "name": "ms-account - Part I",
    "description": "Account-service requests only. Set customerId to an ACTIVE PERSONAL customer, and businessCustomerId plus businessCoHolderId to two ACTIVE BUSINESS customer IDs from ms-customer. The suite verifies personal and business account rules, including fixed-term deposits outside the allowed calendar day; account balances are checked above. Credit-card balance and movement history belong to ms-credit and ms-transaction collections. Requires ms-account and its customer-service/transaction-service dependencies. Account records created by requests 12, 14, 15, 18, 19 and 23 remain in account_db; use a disposable database or remove those test records before rerunning.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "packages": {},
        "exec": [
          "pm.collectionVariables.set('correlationId', pm.variables.replaceIn('{{$guid}}'));"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 - Create personal savings account",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "packages": {},
            "exec": [
              "pm.test('Status is 201 Created', () => pm.response.to.have.status(201));",
              "pm.test('Account opens with zero balance', () => {",
              "    const body = pm.response.json();",
              "    pm.expect(body.id).to.be.a('string').and.not.empty;",
              "    pm.expect(body.accountType).to.equal('SAVINGS');",
              "    pm.expect(body.balance).to.equal(0);",
              "    pm.expect(body.currency).to.equal('PEN');",
              "    pm.expect(body.holders).to.include(pm.variables.get('customerId'));",
              "    pm.expect(pm.response.headers.get('Location')).to.equal('/api/v1/accounts/' + body.id);",
              "    pm.collectionVariables.set('accountId', body.id);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Correlation-ID",
            "value": "{{correlationId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"accountType\": \"SAVINGS\",\n  \"holders\": [\"{{customerId}}\"],\n  \"currency\": \"PEN\",\n  \"maxMonthlyMovements\": 5\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/accounts",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "accounts"
          ]
        }
      },
      "response": []
    },
