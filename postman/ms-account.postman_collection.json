        "body": {
          "mode": "raw",
          "raw": "{\n  \"amount\": 5.25,\n  \"currency\": \"PEN\",\n  \"description\": \"ATM withdrawal\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/accounts/{{accountId}}/withdrawals",
