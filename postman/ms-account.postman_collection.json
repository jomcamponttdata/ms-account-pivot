    {
      "name": "08 - Verify balance after withdrawal",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "packages": {},
            "exec": [
              "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Balance reflects the withdrawal', () => {",
              "    pm.expect(pm.response.json().balance).to.equal(20.25);",
