    {
      "name": "09 - Update editable account fields",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "packages": {},
            "exec": [
              "pm.test('Status is 200 OK', () => pm.response.to.have.status(200));",
              "pm.test('Savings limit is updated', () => {",
              "    const body = pm.response.json();",
              "    pm.expect(body.id).to.equal(pm.collectionVariables.get('accountId'));",
              "    pm.expect(body.maxMonthlyMovements).to.equal(10);",
              "    pm.expect(body.balance).to.equal(20.25);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Correlation-ID",
            "value": "{{correlationId}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"holders\": [\"{{customerId}}\"],\n  \"maxMonthlyMovements\": 10\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{baseUrl}}/api/v1/accounts/{{accountId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "v1",
            "accounts",
            "{{accountId}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "10 - Reject invalid savings limit (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "packages": {},
            "exec": [
              "pm.test('Status is 400 Bad Request', () => pm.response.to.have.status(400));",
              "pm.test('Validation problem is returned', () => {",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
              "    pm.expect(pm.response.json().title).to.equal('Invalid request');",
              "    pm.expect(pm.response.json().detail).to.include('maxMonthlyMovements');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-Correlation-ID",
