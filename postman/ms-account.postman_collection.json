      "name": "12 - Find deleted account returns 404",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "packages": {},
            "exec": [
              "pm.test('Status is 404 Not Found', () => pm.response.to.have.status(404));",
              "pm.test('Not-found problem is returned', () => {",
              "    pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json');",
              "    pm.expect(pm.response.json().title).to.equal('Resource not found');",
              "});"
            ]
          }
